@using Portfolio.Data

<section id="home" class="hero">
    <div class="background-grid"></div>
    <div class="gradient-glow"></div>
    
    <div class="container">
        <div class="hero-content fade-in">
            <h1 class="hero-title">@profileData.Headline</h1>
            <p class="hero-subtitle">@profileData.SubHeadline</p>
            <p class="hero-description">@profileData.Description</p>
            
            <div class="hero-actions">
                <a href="#projects" class="btn btn-primary">Explore My Work</a>
                <a href="#contact" class="btn btn-secondary">Contact Me</a>
                <a href="/assets/Basit-Altaf-Resume.pdf" download class="btn btn-outline" target="_blank">
                    📄 Download Resume
                </a>
            </div>
            
            <div class="hero-social">
                <a href="@profileData.LinkedIn" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
                    <svg class="icon" viewBox="0 0 24 24">
                        <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                        <rect x="2" y="9" width="4" height="12"></rect>
                        <circle cx="4" cy="4" r="2"></circle>
                    </svg>
                </a>
                <a href="mailto:@profileData.Email" aria-label="Email">
                    <svg class="icon" viewBox="0 0 24 24">
                        <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                        <polyline points="22,6 12,13 2,6"></polyline>
                    </svg>
                </a>
            </div>
        </div>
    </div>
</section>

@code {
    private ProfileData profileData = new();
}
