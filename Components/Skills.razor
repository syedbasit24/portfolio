@using Portfolio.Data

<section id="skills" class="skills">
    <div class="container">
        <h2 class="section-title fade-in">Technical Skills</h2>
        <p class="section-subtitle fade-in">Technologies and tools I work with</p>
        
        <div class="skills-grid fade-in">
            @foreach (var category in SkillsData.Categories)
            {
                <div class="card skill-category">
                    <div class="skill-category-header">
                        @GetIconSvg(category.Icon)
                        @category.Name
                    </div>
                    <div class="skill-list">
                        @foreach (var skill in category.Skills)
                        {
                            <span class="badge">@skill</span>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private MarkupString GetIconSvg(string icon)
    {
        return icon switch
        {
            "code" => (MarkupString)"<svg class=\"icon\" viewBox=\"0 0 24 24\"><polyline points=\"16 18 22 12 16 6\"></polyline><polyline points=\"8 6 2 12 8 18\"></polyline></svg>",
            "server" => (MarkupString)"<svg class=\"icon\" viewBox=\"0 0 24 24\"><rect x=\"2\" y=\"2\" width=\"20\" height=\"8\" rx=\"2\" ry=\"2\"></rect><rect x=\"2\" y=\"14\" width=\"20\" height=\"8\" rx=\"2\" ry=\"2\"></rect><line x1=\"6\" y1=\"6\" x2=\"6.01\" y2=\"6\"></line><line x1=\"6\" y1=\"18\" x2=\"6.01\" y2=\"18\"></line></svg>",
            "layout" => (MarkupString)"<svg class=\"icon\" viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\" ry=\"2\"></rect><line x1=\"3\" y1=\"9\" x2=\"21\" y2=\"9\"></line><line x1=\"9\" y1=\"21\" x2=\"9\" y2=\"9\"></line></svg>",
            "database" => (MarkupString)"<svg class=\"icon\" viewBox=\"0 0 24 24\"><ellipse cx=\"12\" cy=\"5\" rx=\"9\" ry=\"3\"></ellipse><path d=\"M21 12c0 1.66-4 3-9 3s-9-1.34-9-3\"></path><path d=\"M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5\"></path></svg>",
            "tool" => (MarkupString)"<svg class=\"icon\" viewBox=\"0 0 24 24\"><path d=\"M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z\"></path></svg>",
            _ => (MarkupString)"<svg class=\"icon\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle></svg>"
        };
    }
}
